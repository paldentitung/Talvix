generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String @id @default(cuid())
  email     String @unique
  password  String
  firstName String
  lastName  String
  role      Role   @default(CANDIDATE)

  avatar   String?
  phone    String?
  bio      String? @db.Text
  location String?
  title    String?

  resumeUrl String?

  jobs Job[]

  isVerified          Boolean   @default(false)
  verificationToken   String?
  verificationExpires DateTime?

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id             String   @id @default(cuid())
  title          String
  description    String
  salary         Int?
  location       String
  employmentType String
  experience     String
  skills         String[]
  deadline       DateTime
  status         String

  recruiterId String
  recruiter   User   @relation(fields: [recruiterId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  RECRUITER
  CANDIDATE
}
